{
  "name": "@revenant/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared types, policy grid, decline taxonomy and audit event schema",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./data/*.json": "./data/*.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

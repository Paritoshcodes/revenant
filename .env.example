# Secrets and machine-specific values only.
#
# Ports, the zrok share name and the public webhook URL are CONSTANTS in
# apps/gateway/src/config.ts, not env vars, so they cannot drift out of sync
# with the things derived from them.

# Postgres. A password containing @ must be percent-encoded as %40.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/revenant

# Razorpay TEST keys: dashboard -> Account & Settings -> API Keys.
RZP_KEY=rzp_test_<yours>
RZP_SECRET=<yours>

# Any string you choose. Must match the secret entered in the Razorpay
# dashboard when registering the webhook, or every event is rejected.
RZP_WEBHOOK_SECRET=CHANGE_ME

# Optional. Defaults to http://localhost:8000 when unset.
# ENGINE_URL=http://localhost:8000

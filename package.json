{
  "name": "revenant",
  "version": "0.0.0",
  "private": true,
  "description": "Payment recovery agent that measures its own incremental effect",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contracts",
    "apps/gateway",
    "apps/dashboard"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -b packages/contracts apps/gateway apps/dashboard",
    "typecheck": "npm run build",
    "clean": "tsc -b --clean packages/contracts apps/gateway apps/dashboard",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/gateway"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
